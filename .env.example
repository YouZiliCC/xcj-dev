# 数据库：默认 SQLite。如要使用 MySQL，将 DB_DRIVER 改为 mysql 并填写 DSN
DB_DRIVER=sqlite
DB_DSN=./data/storage/papers.db
# MySQL 示例:
# DB_DRIVER=mysql
# DB_DSN=user:pass@tcp(127.0.0.1:3306)/papers?parseTime=true&charset=utf8mb4

# Python 侧车（嵌入 / LLM / 分析）
PY_SERVICE_URL=http://127.0.0.1:8001

# 大模型（OpenAI 兼容协议）。当前用支持 Claude 的中转端点（Opus 4.8）；
# 火山方舟 / DashScope / 智谱等任意 OpenAI 兼容服务均可替换。
# scripts/dev.sh 与 scripts/ingest.sh 里硬编码的旧默认值仅作环境变量缺省时的兜底。
LLM_BASE_URL=https://yunwu.ai/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=claude-opus-4-8
LLM_TEMPERATURE=0.2

# 嵌入模型：本地 SentenceTransformer 模型名或 OpenAI 嵌入名（当前 LLM 中转端点不提供嵌入接口，故走本地）
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 后端监听
API_ADDR=:8080
CORS_ORIGIN=http://localhost:5173
